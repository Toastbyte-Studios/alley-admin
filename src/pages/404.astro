---
import Background from '../components/Background.astro';
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';

/**
 * Astro emits this as `dist/404.html`, which Cloudflare Pages serves for any
 * unmatched path with a real 404 status. No configuration needed — Pages picks
 * the file up by name.
 *
 * `noindex` matters here: without it a crawler that reaches a bad URL can index
 * the error page itself, and because this is a static file every wrong path
 * returns identical content. `follow` is kept so the links back to the site
 * still pass through.
 */
---

<Layout
  title="Page Not Found | Alley Admin"
  description="That page rolled into the gutter. Head back to alleyadmin.app to join the waitlist for professional bowling league management software."
  robots="noindex, follow"
>
  <div class="page">
    <Background />
    <SiteHeader />

    <main class="content">
      <section class="not-found" aria-labelledby="not-found-title">
        <p class="code" aria-hidden="true">404</p>

        <h1 id="not-found-title" class="title">
          <span class="gutter-text">Gutter ball.</span>
          That page isn't here
        </h1>

        <p class="description">
          The link may be broken, or the page may have been moved. Alley Admin
          is still in development, so there is not much here yet either way.
        </p>

        <div class="actions">
          <a class="button-primary" href="/">Back to the lanes</a>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      var(--color-bg) 0%,
      var(--color-bg-sunken) 100%
    );
  }

  .content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .not-found {
    text-align: center;
  }

  /* Decorative, so it is hidden from assistive tech — the heading carries the
     actual message. */
  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 7.5rem);
    font-weight: 800;
    line-height: 1;
    margin: 0 0 var(--space-sm);
    letter-spacing: -0.03em;
    background: linear-gradient(
      135deg,
      var(--color-primary),
      var(--color-accent)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3.6vw, 1.875rem);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .gutter-text {
    color: var(--color-accent);
  }

  .description {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 46ch;
    margin: 0 auto var(--space-lg);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    justify-content: center;
  }

  .button-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.8125rem 1.5rem;
    background: var(--color-primary);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-primary-contrast);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow: var(--shadow-primary);
    transition:
      background-color 0.2s var(--ease),
      transform 0.15s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .button-primary:active {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .content {
      padding: var(--space-xl) var(--space-sm);
    }
  }
</style>
