---
// Ambient lane motif: a soft glow behind the hero, a fine pin-deck dot grid,
// and lane strips anchored to the bottom edge. Purely decorative — kept low
// contrast so it reads as texture in both themes rather than as an image.
---

<div class="backdrop" aria-hidden="true">
  <div class="glow"></div>
  <div class="pin-grid"></div>
  <div class="lanes">
    <span class="lane"></span>
    <span class="lane"></span>
    <span class="lane"></span>
    <span class="lane"></span>
    <span class="lane"></span>
  </div>
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* Soft primary-tinted glow sitting behind the hero */
  .glow {
    position: absolute;
    top: -18%;
    left: 50%;
    width: min(1000px, 130%);
    height: 620px;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      var(--color-primary-soft) 0%,
      transparent 68%
    );
  }

  /* Pin-deck dot grid */
  .pin-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      var(--color-pin-dot) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 72%);
  }

  /* Lane strips running up from the foul line */
  .lanes {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, 96%);
    height: 45vh;
    display: flex;
    gap: 2px;
    mask-image: linear-gradient(0deg, #000 0%, transparent 88%);
    -webkit-mask-image: linear-gradient(0deg, #000 0%, transparent 88%);
  }

  .lane {
    flex: 1;
    background: var(--color-lane);
    border-left: 1px solid var(--color-lane-edge);
    border-right: 1px solid var(--color-lane-edge);
  }

  @media (max-width: 768px) {
    .lanes {
      height: 30vh;
    }

    .lane:nth-child(n + 4) {
      display: none;
    }
  }
</style>
