---
/**
 * Alley Admin mark: bowling pins 1–7 and 10 racked into a letter "A", with the
 * ball at the apex. Pins 8 and 9 are omitted so the legs read as strokes; the
 * 4/5/6 row stands in for the crossbar.
 *
 * Geometry note: pins 1, 2, 4, 7 are exactly collinear, as are 1, 3, 6, 10 —
 * the rack's own spacing produces the letterform, so don't nudge individual
 * pins without recomputing both diagonals.
 *
 * `open` draws the pins in the primary color for use on a page background.
 * `badge` knocks them out of a filled tile, for favicons and app icons where
 * loose dots on an open background lose legibility.
 */
interface Props {
  size?: number;
  variant?: 'open' | 'badge';
  animated?: boolean;
  title?: string;
  class?: string;
}

const {
  size = 26,
  variant = 'open',
  animated = false,
  title,
  class: className,
} = Astro.props as Props;

const pins = [
  { cx: 32, cy: 23.5 },
  { cx: 24, cy: 34.5 },
  { cx: 40, cy: 34.5 },
  { cx: 16, cy: 45.5 },
  { cx: 32, cy: 45.5 },
  { cx: 48, cy: 45.5 },
  { cx: 8, cy: 56.5 },
  { cx: 56, cy: 56.5 },
];

const isBadge = variant === 'badge';
const pinRadius = isBadge ? 4.2 : 4;
---

<svg
  class:list={['logo', `logo-${variant}`, animated && 'is-animated', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {isBadge && <rect width="64" height="64" rx="14" class="badge" />}

  <g
    transform={isBadge
      ? 'translate(32,32) scale(0.78) translate(-32,-32)'
      : undefined}
  >
    <circle cx="32" cy="10" r="6.5" class="ball"></circle>
    {
      pins.map((pin) => (
        <circle cx={pin.cx} cy={pin.cy} r={pinRadius} class="pin" />
      ))
    }
  </g>
</svg>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
  }

  .badge {
    fill: var(--color-primary);
  }

  .ball {
    fill: var(--color-accent);
  }

  .logo-open .pin {
    fill: var(--color-primary);
  }

  .logo-badge .pin {
    fill: var(--color-board-pin);
  }

  /*
   * Optional entrance for the hero: pins set top-down like a rack dropping,
   * then the ball arrives at the apex, then the whole mark drifts.
   *
   * Transforms here are in SVG user units, not px — the viewBox is 64 wide, so
   * translateY(-6) is a little under a tenth of the mark's height regardless of
   * the rendered size. Scale is avoided deliberately: scaling an SVG circle
   * about its own center needs transform-box: fill-box, which buys nothing here.
   *
   * Every keyframe ends on the visible state, so the global
   * prefers-reduced-motion rule collapses these to a static, correct mark.
   */
  .is-animated {
    animation: logo-drift 5s ease-in-out 1.2s infinite;
  }

  .is-animated .pin {
    animation: pin-set 0.45s var(--ease) both;
  }

  .is-animated .ball {
    animation: ball-drop 0.55s var(--ease) 0.5s both;
  }

  .is-animated .pin:nth-of-type(2) {
    animation-delay: 0.06s;
  }
  .is-animated .pin:nth-of-type(3) {
    animation-delay: 0.12s;
  }
  .is-animated .pin:nth-of-type(4) {
    animation-delay: 0.12s;
  }
  .is-animated .pin:nth-of-type(5) {
    animation-delay: 0.18s;
  }
  .is-animated .pin:nth-of-type(6) {
    animation-delay: 0.18s;
  }
  .is-animated .pin:nth-of-type(7) {
    animation-delay: 0.18s;
  }
  .is-animated .pin:nth-of-type(8) {
    animation-delay: 0.24s;
  }
  .is-animated .pin:nth-of-type(9) {
    animation-delay: 0.24s;
  }

  @keyframes pin-set {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ball-drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes logo-drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2.5%);
    }
  }
</style>
