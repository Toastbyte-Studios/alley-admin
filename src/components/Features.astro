---
// Feature cards. The numbered chips are kept from the original scoreboard
// styling, but sit inline in the card flow rather than overlapping the border.
---

<section class="features" aria-labelledby="features-heading">
  <h2 id="features-heading" class="visually-hidden">Key Features</h2>

  <article class="feature-card">
    <div class="feature-number" aria-hidden="true">01</div>
    <h3>League Management</h3>
    <p>
      Organize teams, schedules, and tournaments with ease. Complete league
      administration tools for bowling alley managers and league coordinators.
    </p>
  </article>

  <article class="feature-card">
    <div class="feature-number" aria-hidden="true">02</div>
    <h3>Score Tracking</h3>
    <p>
      Digital scorekeeping that's better than the old scoreboards. Real-time
      score updates and automatic handicap calculations.
    </p>
  </article>

  <article class="feature-card">
    <div class="feature-number" aria-hidden="true">03</div>
    <h3>Team Statistics</h3>
    <p>
      Track performance, averages, and league standings. Comprehensive analytics
      and reporting for bowlers and teams.
    </p>
  </article>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
    text-align: left;
  }

  .feature-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  /* Lane stripe along the top edge, revealed on hover */
  .feature-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: var(--space-md);
    right: var(--space-md);
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }

  .feature-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: var(--space-sm);
    background: var(--color-primary-soft);
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }

  .feature-card h3 {
    color: var(--color-text);
    font-size: 1.1875rem;
    margin: 0 0 0.5rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
</style>
