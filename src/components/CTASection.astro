---
// Waitlist signup. The POST contract with the registration Worker is
// unchanged: JSON { email }, 201 on success, 400 on a bad address.
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-box">
    <h2 id="cta-heading" class="cta-text">
      <span class="strike-text">Strike!</span>
      Join the waitlist for the future of league management
    </h2>

    <form class="notify-form" id="notifyForm">
      <label class="visually-hidden" for="notifyEmail">Email address</label>
      <input
        type="email"
        id="notifyEmail"
        name="email"
        placeholder="your.email@example.com"
        autocomplete="email"
        required
        class="email-input"
      />
      <button type="submit" class="submit-button" id="submitButton">
        Reserve Your Spot
      </button>
    </form>

    <p class="form-message" id="formMessage">
      We'll notify you when lanes open. No spam, guaranteed.
    </p>
  </div>
</section>

<script>
  import { ANALYTICS_EVENTS, trackClientEvent } from '../lib/analytics-client';

  const form = document.getElementById('notifyForm');
  const submitButton = document.getElementById('submitButton');
  const formMessage = document.getElementById('formMessage');

  if (
    form instanceof HTMLFormElement &&
    submitButton instanceof HTMLButtonElement &&
    formMessage instanceof HTMLParagraphElement
  ) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]');
      if (!(input instanceof HTMLInputElement) || !input.value) return;

      submitButton.disabled = true;
      submitButton.textContent = 'Reserving...';
      formMessage.classList.remove('is-error');

      trackClientEvent(ANALYTICS_EVENTS.waitlistSignupStarted);

      // Set before the request and narrowed once we have a status, so the
      // catch below reports what actually went wrong rather than lumping a
      // rejected address in with a dropped connection.
      let failureReason = 'network_error';

      try {
        const workerUrl =
          import.meta.env.PUBLIC_WORKER_URL ??
          'https://alleyadmin-registration-worker.jshprintz.workers.dev';
        const response = await fetch(workerUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value }),
        });

        let serverMessage = '';
        if (!response.ok) {
          try {
            const errorBody = await response.json();
            if (
              errorBody &&
              typeof errorBody === 'object' &&
              'error' in errorBody &&
              typeof errorBody.error === 'string'
            ) {
              serverMessage = errorBody.error;
            }
          } catch {
            // Ignore JSON parsing failures and fall back to generic messaging.
          }
        }

        if (response.ok) {
          trackClientEvent(ANALYTICS_EVENTS.waitlistSignupSucceeded);
          form.style.display = 'none';
          formMessage.textContent =
            "You're on the list! We'll notify you when we launch. 🎳";
          formMessage.classList.add('is-success');
        } else {
          failureReason =
            response.status === 400
              ? 'invalid_email'
              : response.status >= 500
                ? 'server_error'
                : `http_${response.status}`;
          throw new Error(
            serverMessage || 'Something went wrong. Please try again.',
          );
        }
      } catch (error) {
        trackClientEvent(ANALYTICS_EVENTS.waitlistSignupFailed, {
          reason: failureReason,
        });
        formMessage.textContent =
          error instanceof Error
            ? error.message
            : 'Something went wrong. Please try again.';
        formMessage.classList.add('is-error');
        submitButton.disabled = false;
        submitButton.textContent = 'Reserve Your Spot';
      }
    });
  }
</script>

<style>
  .cta-section {
    display: flex;
    justify-content: center;
  }

  .cta-box {
    position: relative;
    width: 100%;
    max-width: 620px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-md);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  /* Foul-line stripe across the top of the card */
  .cta-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-primary),
      var(--color-accent)
    );
  }

  .cta-text {
    font-size: clamp(1.125rem, 2.4vw, 1.375rem);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-md);
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .strike-text {
    color: var(--color-accent);
    font-weight: 800;
  }

  .notify-form {
    display: flex;
    gap: 0.625rem;
    margin-bottom: var(--space-sm);
  }

  .email-input {
    flex: 1;
    min-width: 0;
    padding: 0.8125rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 1rem;
    font-family: inherit;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .email-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-ring);
  }

  .email-input::placeholder {
    color: var(--color-text-subtle);
  }

  .submit-button {
    flex-shrink: 0;
    padding: 0.8125rem 1.5rem;
    background: var(--color-primary);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--color-primary-contrast);
    font-size: 0.9375rem;
    font-weight: 600;
    font-family: inherit;
    letter-spacing: 0.01em;
    cursor: pointer;
    box-shadow: var(--shadow-primary);
    transition:
      background-color 0.2s var(--ease),
      transform 0.15s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .submit-button:hover:not(:disabled) {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .submit-button:active:not(:disabled) {
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  .submit-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    box-shadow: none;
  }

  .form-message {
    color: var(--color-text-subtle);
    font-size: 0.8125rem;
    margin: 0;
  }

  .form-message.is-success {
    color: var(--color-primary);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .form-message.is-error {
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 560px) {
    .notify-form {
      flex-direction: column;
    }

    .submit-button {
      width: 100%;
      padding: 0.875rem 1.5rem;
    }
  }
</style>
