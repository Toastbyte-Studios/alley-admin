---
import BowlingIcon from './BowlingIcon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="icon-wrapper">
    <BowlingIcon />
  </div>

  <div class="badge" role="status">
    <span class="badge-dot" aria-hidden="true"></span>
    <span class="badge-text">Opening Soon</span>
  </div>

  <h1 id="hero-title" class="title">
    <span class="title-main">Alley Admin</span>
    <span class="title-tagline">League Management Reimagined</span>
  </h1>

  <p class="hero-description">
    Professional bowling league management software designed to streamline your
    league operations, track scores digitally, and provide comprehensive team
    statistics and performance analytics.
  </p>
</section>

<style>
  .hero {
    text-align: center;
  }

  .icon-wrapper {
    margin-bottom: var(--space-md);
    display: flex;
    justify-content: center;
  }

  /* Status pill with a live indicator dot */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
    padding: 0.4375rem 0.9375rem 0.4375rem 0.75rem;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-pill);
  }

  .badge-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--color-primary);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .badge-text {
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .title {
    margin: 0 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .title-main {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5.25rem);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .title-tagline {
    font-size: clamp(0.875rem, 2vw, 1.0625rem);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-description {
    max-width: 620px;
    margin: 0 auto;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  @media (max-width: 480px) {
    .icon-wrapper {
      margin-bottom: var(--space-sm);
    }
  }
</style>
