---
// Light/dark toggle. Defaults to the OS preference and only writes to
// localStorage once the user makes an explicit choice, so the site keeps
// following the system setting until they say otherwise.
---

<button
  type="button"
  class="theme-toggle"
  id="themeToggle"
  aria-label="Switch color theme"
>
  <svg
    class="icon icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="icon icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  import { ANALYTICS_EVENTS, trackClientEvent } from '../lib/analytics-client';

  const STORAGE_KEY = 'aa-theme';
  const toggle = document.getElementById('themeToggle');

  function label(theme: string): string {
    return theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
  }

  if (toggle instanceof HTMLButtonElement) {
    const current =
      document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'dark'
        : 'light';
    toggle.setAttribute('aria-label', label(current));

    toggle.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark'
          ? 'light'
          : 'dark';

      document.documentElement.setAttribute('data-theme', next);
      toggle.setAttribute('aria-label', label(next));

      trackClientEvent(ANALYTICS_EVENTS.themeToggled, { theme: next });

      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Storage can be unavailable (private mode, blocked cookies).
        // The theme still applies for this page view.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .theme-toggle:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .icon {
    position: absolute;
    width: 1.125rem;
    height: 1.125rem;
    transition:
      opacity 0.2s var(--ease),
      transform 0.25s var(--ease);
  }

  /* Show the icon for the theme you'd switch *to*. */
  .icon-sun {
    opacity: 0;
    transform: rotate(-45deg) scale(0.7);
  }

  .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global([data-theme='dark']) .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :global([data-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(45deg) scale(0.7);
  }
</style>
