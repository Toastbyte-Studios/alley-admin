---
import pkg from '../../package.json';

const dateYear: string = new Date().getFullYear().toString();
const version: string = pkg.version;
---

<footer class="footer">
  <div class="footer-content">
    <nav class="footer-nav" aria-label="Footer">
      <a href="/privacy">Privacy Policy</a>
    </nav>
    <p class="footer-line">
      &copy; {dateYear} Alley Admin • Crafted with care for bowling enthusiasts •
      A product of <a
        href="https://toastbyte.studio"
        data-outbound="toastbyte-studio">Toastbyte Studios</a
      >
    </p>
    <p class="footer-version">v{version}</p>
  </div>
</footer>

<script>
  import { ANALYTICS_EVENTS, trackClientEvent } from '../lib/analytics-client';

  // Keyed off the attribute rather than an id so adding another outbound link
  // is a markup change, not a script change.
  for (const link of document.querySelectorAll('a[data-outbound]')) {
    if (!(link instanceof HTMLAnchorElement)) continue;

    link.addEventListener('click', () => {
      trackClientEvent(ANALYTICS_EVENTS.outboundLinkClicked, {
        destination: link.dataset.outbound ?? 'unknown',
        href: link.href,
      });
    });
  }
</script>

<style>
  .footer {
    position: relative;
    z-index: 10;
    width: 100%;
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-sunken);
    padding: var(--space-md);
  }

  .footer-content {
    max-width: var(--content-width);
    margin: 0 auto;
    text-align: center;
  }

  .footer-nav {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
  }

  .footer-line {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    margin: 0;
  }

  .footer-version {
    margin: 0.375rem 0 0;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .footer a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid transparent;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .footer a:hover {
    color: var(--color-primary-hover);
    border-bottom-color: currentColor;
  }
</style>
