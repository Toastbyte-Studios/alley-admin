---
// Retro scoreboard mark. Composition and motion are unchanged from the
// original; colors now come from tokens so it reads correctly in both themes.
// The board face stays dark in light mode on purpose — a lit scoreboard in a
// dim room is the whole idea.
---

<svg
  class="bowling-icon"
  width="168"
  height="148"
  viewBox="0 0 160 140"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Retro bowling scoreboard"
>
  <!-- Scoreboard frame -->
  <rect
    x="10"
    y="10"
    width="140"
    height="120"
    rx="10"
    class="board-face"
    stroke-width="2.5"></rect>

  <!-- Inner frame accent -->
  <rect
    x="19"
    y="19"
    width="122"
    height="102"
    rx="6"
    fill="none"
    class="board-inner"
    stroke-width="1"></rect>

  <!-- Top rail -->
  <line x1="19" y1="43" x2="141" y2="43" class="board-rail" stroke-width="1"
  ></line>

  <!-- Pin rack, arranged in the standard triangle -->
  <g class="pins">
    <circle cx="55" cy="58" r="5" class="pin" stroke-width="1.5"></circle>
    <circle cx="70" cy="58" r="5" class="pin" stroke-width="1.5"></circle>
    <circle cx="85" cy="58" r="5" class="pin" stroke-width="1.5"></circle>
    <circle cx="100" cy="58" r="5" class="pin" stroke-width="1.5"></circle>

    <circle cx="62" cy="70" r="5" class="pin" stroke-width="1.5"></circle>
    <circle cx="78" cy="70" r="5" class="pin" stroke-width="1.5"></circle>
    <circle cx="93" cy="70" r="5" class="pin" stroke-width="1.5"></circle>

    <circle cx="70" cy="82" r="5" class="pin" stroke-width="1.5"></circle>
    <circle cx="85" cy="82" r="5" class="pin" stroke-width="1.5"></circle>

    <circle cx="77.5" cy="94" r="5.5" class="pin pin-head" stroke-width="2"
    ></circle>
  </g>

  <!-- Bowling ball -->
  <g class="ball">
    <circle cx="80" cy="112" r="11" fill="url(#ballGradient)"></circle>
    <circle cx="76.5" cy="108" r="1.8" class="ball-hole"></circle>
    <circle cx="83.5" cy="107.5" r="1.8" class="ball-hole"></circle>
    <circle cx="80" cy="114" r="1.8" class="ball-hole"></circle>
    <circle cx="75.5" cy="107" r="2.6" fill="#ffffff" opacity="0.28"></circle>
  </g>

  <!-- Strike lights -->
  <g class="lights">
    <circle cx="32" cy="31" r="3" class="light"></circle>
    <circle cx="128" cy="31" r="3" class="light"></circle>
  </g>

  <defs>
    <radialGradient id="ballGradient" cx="35%" cy="30%">
      <stop offset="0%" class="ball-stop-1"></stop>
      <stop offset="55%" class="ball-stop-2"></stop>
      <stop offset="100%" class="ball-stop-3"></stop>
    </radialGradient>
  </defs>
</svg>

<style>
  .bowling-icon {
    filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.18));
    animation: float 3s ease-in-out infinite;
  }

  .board-face {
    fill: var(--color-board-face);
    stroke: var(--color-board-frame);
  }

  .board-inner,
  .board-rail {
    stroke: var(--color-board-frame);
    opacity: 0.35;
  }

  .pin {
    fill: var(--color-board-pin);
    stroke: var(--color-board-pin-edge);
  }

  .pin-head {
    stroke: var(--color-board-frame);
  }

  .ball-hole {
    fill: var(--color-board-face);
  }

  .ball-stop-1 {
    stop-color: var(--aa-strike-400);
  }

  .ball-stop-2 {
    stop-color: var(--aa-strike-500);
  }

  .ball-stop-3 {
    stop-color: var(--aa-strike-600);
  }

  .light {
    fill: var(--color-highlight);
  }

  .pins {
    animation: pinShake 3s ease-in-out infinite;
    transform-origin: 77.5px 76px;
  }

  .ball {
    animation: ballRoll 4s ease-in-out infinite;
    transform-origin: 80px 112px;
  }

  .lights {
    animation: blink 1.5s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes pinShake {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-1deg);
    }
    75% {
      transform: rotate(1deg);
    }
  }

  @keyframes ballRoll {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(180deg);
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
</style>
