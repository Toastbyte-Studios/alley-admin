# Cloudflare Pages reads this file from the build output root and applies the
# rules below to matching responses. See:
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The Content-Security-Policy itself is not set here — Astro generates a
# hash-based policy per page from `security.csp` in astro.config.mjs, which
# keeps the script and style hashes in sync with the build automatically.
# `frame-ancestors` is not honoured in a <meta> CSP, so X-Frame-Options below
# is what actually blocks framing.

/*
  # Force HTTPS for a year. `preload` is deliberately omitted: submitting to the
  # browser preload list is difficult to reverse, so it should be an explicit
  # decision rather than a side effect of this file.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No third party should be able to frame the site.
  X-Frame-Options: DENY
  # Don't let browsers guess a content type that differs from the declared one.
  X-Content-Type-Options: nosniff
  # Isolate the browsing context group from any window that opens us.
  Cross-Origin-Opener-Policy: same-origin
  # Send the full URL to ourselves, origin-only to other HTTPS origins.
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing on this site needs these, so turn them off.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Everything under /_astro/ is content-hashed by the build, so it can be cached
# indefinitely and never revalidated.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
